{
  "type": "wokwi-lcd1602",
  "name": "LCD 16×2",
  "category": "Output",
  "description": "16×2 character LCD with an HD44780 controller. Interface \"i2c\" is the common 4-pin backpack (PCF8574, address 0x27 or 0x3F; use the LiquidCrystal_I2C library). Interface \"full\" is the bare 16-pin module (RS, E, D4-D7 driven by GPIO; use the LiquidCrystal library).",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "idPrefix": "lcd",
  "props": {
    "pins": { "type": "select", "label": "Interface", "default": "full", "options": ["full", "i2c"] },
    "i2cAddress": {
      "type": "select",
      "label": "I²C address",
      "default": "0x27",
      "options": ["0x20", "0x21", "0x22", "0x23", "0x24", "0x25", "0x26", "0x27", "0x38", "0x39", "0x3A", "0x3B", "0x3C", "0x3D", "0x3E", "0x3F"]
    },
    "background": { "type": "select", "label": "Backlight", "default": "green", "options": ["green", "blue"] },
    "color": { "type": "select", "label": "Text colour", "default": "black", "options": ["black", "white"] },
    "variant": { "type": "select", "label": "Character set", "default": "A00", "options": ["A00", "A02"] }
  },
  "newAttrs": { "pins": "i2c" },
  "tags": ["basic"]
}
