{
  "name": "axion",
  "version": "0.4.1",
  "description": "Axion: a lightweight, offline, open-source circuit and microcontroller simulator with pluggable parts.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && vite preview --port 5173",
    "setup": "node scripts/setup.mjs",
    "test": "vitest run",
    "check:examples": "node scripts/check-examples.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wokwi/elements": "1.9.2",
    "avr8js": "0.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
